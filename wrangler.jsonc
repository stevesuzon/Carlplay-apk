{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carplay-telephone",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carplay-metiers",
      "database_id": "8c139641-68af-44cc-aa8f-2a68af669c4a"
    },
    {
      "binding": "ROAD_REPORTS",
      "database_name": "gps-road-reports",
      "database_id": "3aea8337-27c2-4d86-aa55-a540563ca698"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
