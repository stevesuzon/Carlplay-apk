<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no"><title>Les 4 Pauvres Diables — Mode voiture</title>
<style>*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:#fff;overflow-x:hidden}
body{min-height:100svh;background:linear-gradient(90deg,rgba(3,5,11,.55),rgba(3,5,11,.08) 48%,rgba(3,5,11,.35)),linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.48)),url("assets/hero-les-4-pauvres-diables-sans-boutons.jpg") center/cover fixed no-repeat}
.shell{min-height:100svh;padding:14px 18px;display:flex;flex-direction:column;justify-content:center}.top{position:fixed;left:18px;right:18px;top:12px;display:flex;justify-content:space-between;align-items:center;z-index:5}.status{font-size:18px;font-weight:900;text-shadow:0 2px 6px #000}.gear{width:64px;height:64px;border-radius:22px;border:1px solid #ffffff55;background:#243148e6;color:white;font-size:33px;box-shadow:0 10px 28px #0008}
.grid{width:min(1050px,96vw);margin:66px auto 0;display:grid;grid-template-columns:1.12fr 1fr;gap:18px}.tile{position:relative;overflow:hidden;min-height:235px;border-radius:32px;padding:26px;border:2px solid #ffffff50;box-shadow:0 18px 45px #0007;color:white;display:flex;align-items:center;cursor:pointer}.blue{background:linear-gradient(135deg,#00b7ff,#0872ff 50%,#5646ee)}.orange{background:linear-gradient(135deg,#ff2d55,#ff6b22 52%,#ffb000)}
.tile img{height:180px;max-width:38%;object-fit:contain;filter:drop-shadow(0 9px 12px #0008);flex:none}.txt{margin-left:20px;min-width:0}.badge{display:inline-block;padding:8px 14px;border-radius:18px;background:#102e72aa;border:1px solid #ffffff55;font-weight:900;font-size:16px}.title{font-size:clamp(38px,5vw,58px);font-weight:1000;line-height:.95;margin:16px 0 7px}.desc{font-size:18px;font-weight:750}
.bottom{width:min(1050px,96vw);margin:18px auto 0;display:grid;grid-template-columns:1.4fr 1fr;gap:18px}.small{min-height:105px;border-radius:28px;border:2px solid #ffffff55;box-shadow:0 15px 38px #0007;display:flex;align-items:center;justify-content:center;padding:14px 20px;font-size:clamp(20px,2.5vw,31px);font-weight:1000;cursor:pointer}.green{background:linear-gradient(135deg,#30d158,#00c7be,#0a84ff)}.red{background:linear-gradient(135deg,#ff375f,#ff453a)}
.small img{height:86px;max-width:26%;object-fit:contain;margin-right:16px;filter:drop-shadow(0 8px 10px #0007)}
.panel{display:none;position:fixed;inset:0;z-index:20;background:#03060ccc;backdrop-filter:blur(12px);align-items:center;justify-content:center;padding:18px}.panel.open{display:flex}.box{width:min(600px,96vw);max-height:92vh;overflow:auto;border-radius:28px;padding:20px;background:linear-gradient(150deg,#24324dee,#0b101dee);border:1px solid #ffffff55;box-shadow:0 24px 70px #000c}.box h2{margin:0 0 12px}.opt{width:100%;margin:7px 0;padding:15px 16px;border:1px solid #ffffff55;border-radius:18px;color:white;background:linear-gradient(135deg,#0a84ff,#5e5ce6);font-size:17px;font-weight:950;text-align:left}.close{background:#ffffff18}.progress{display:none;margin:12px 0}.track{height:18px;border-radius:10px;overflow:hidden;background:#111}.bar{height:100%;width:0;background:linear-gradient(90deg,#30d158,#64d2ff)}.ptext{font-weight:900;margin-bottom:7px}
@media(max-width:760px){.grid,.bottom{grid-template-columns:1fr}.tile{min-height:170px}.tile img{height:120px}.small{min-height:80px}.small img{height:65px}.title{font-size:36px}.shell{padding-top:80px}}
@media(orientation:landscape) and (max-height:650px){.shell{padding:8px 14px}.top{top:7px}.gear{width:52px;height:52px}.grid{margin-top:52px;gap:10px}.tile{min-height:155px;padding:16px}.tile img{height:125px}.title{font-size:36px;margin:9px 0 4px}.desc{font-size:13px}.bottom{margin-top:10px;gap:10px}.small{min-height:70px;font-size:18px}.small img{height:58px}.badge{font-size:12px;padding:6px 10px}}
</style></head><body><div class="shell"><div class="top"><div id="net" class="status">5G &nbsp; <span id="clock"></span></div><button class="gear" onclick="openSettings()">⚙️</button></div>
<div class="grid"><div class="tile blue" onclick="location.href='carplay-marches.html'"><img src="assets/master-front.png" alt=""><div class="txt"><span class="badge">FRANCE + BELGIQUE</span><div class="title">MARCHÉS</div><div class="desc">Trouver rapidement un marché et lancer le GPS</div></div></div>
<div class="tile orange" onclick="location.href='coin.html'"><div class="txt"><span class="badge">POSITIONS</span><div class="title">COIN DE CHINE</div><div class="desc">Enregistrer et retrouver tes coins de chine</div></div></div></div>
<div class="bottom"><div class="small green" onclick="returnPlace()"><img src="assets/tabbert.png" alt="">RETROUVE LA PLACE</div><div class="small red" onclick="erasePlace()">🗑️ &nbsp; EFFACER EMPLACEMENT</div></div></div>
<div id="settings" class="panel"><div class="box"><h2>⚙️ RÉGLAGES</h2>
<button class="opt" onclick="gpsPanel.classList.add('open');settings.classList.remove('open')">🧭 CHOISIR MON GPS</button>
<button class="opt" onclick="openOffline('France')">🇫🇷 TÉLÉCHARGER CARTE DE FRANCE</button>
<button class="opt" onclick="openOffline('Belgique')">🇧🇪 TÉLÉCHARGER CARTE DE BELGIQUE</button>
<button class="opt" onclick="checkUpdate()">🔄 MISE À JOUR DE L'APPLI</button>
<div id="progress" class="progress"><div id="ptext" class="ptext"></div><div class="track"><div id="bar" class="bar"></div></div></div>
<div id="updateStatus"></div><button class="opt close" onclick="settings.classList.remove('open')">← RETOUR</button></div></div>
<div id="gpsPanel" class="panel"><div class="box"><h2>🧭 CHOISIR MON GPS</h2><button class="opt" onclick="saveGps('google')">🗺️ GOOGLE MAPS — GPS HORS LIGNE</button><button class="opt" onclick="saveGps('waze')">🔵 WAZE</button><button class="opt close" onclick="gpsPanel.classList.remove('open');settings.classList.add('open')">← RETOUR</button></div></div>
<script>
const PLACE='les4pauvresdiables_saved_market_place_v2',NAV='l4pd_vehicle_navigation_preference_v1';
function tick(){clock.textContent=new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});net.firstChild.nodeValue=(navigator.onLine?'5G ':'HORS LIGNE ')+'  '}tick();setInterval(tick,30000);addEventListener('online',tick);addEventListener('offline',tick);
function openSettings(){settings.classList.add('open')}function saveGps(x){localStorage.setItem(NAV,x);gpsPanel.classList.remove('open');settings.classList.add('open');alert(x==='waze'?'Waze sélectionné.':'Google Maps sélectionné.')}
function getPlace(){try{return JSON.parse(localStorage.getItem(PLACE)||'null')}catch(e){return null}}
function saveHere(){if(!navigator.geolocation)return alert('GPS indisponible.');navigator.geolocation.getCurrentPosition(p=>{localStorage.setItem(PLACE,JSON.stringify({lat:p.coords.latitude,lng:p.coords.longitude,savedAt:Date.now()}));alert('Place enregistrée. Appuie de nouveau sur « Retrouve la place » pour y revenir.')},()=>alert('Autorise la localisation GPS.'),{enableHighAccuracy:true,timeout:15000})}
function go(dest){if((localStorage.getItem(NAV)||'google')==='waze')location.href='waze://?ll='+dest+'&navigate=yes';else location.href='google.navigation:q='+dest+'&mode=d'}
function returnPlace(){const p=getPlace();if(!p){saveHere();return}go(p.lat+','+p.lng)}
function erasePlace(){if(!getPlace())return alert('Aucun emplacement de retour enregistré.');if(confirm('Effacer uniquement la position « Retrouve la place » ?')){localStorage.removeItem(PLACE);alert('Emplacement de retour effacé.')}}
function openOffline(c){alert('Ouverture de Google Maps pour préparer les plans hors connexion de '+c+'.');location.href='https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(c)}
const LOCAL_VERSION='2026.08.18.1',MANIFEST='https://voiture.appli-suzon.workers.dev/update.json';
function newer(a,b){a=String(a).split(/[^0-9]+/).filter(Boolean).map(Number);b=String(b).split(/[^0-9]+/).filter(Boolean).map(Number);for(let i=0;i<Math.max(a.length,b.length);i++){if((a[i]||0)>(b[i]||0))return true;if((a[i]||0)<(b[i]||0))return false}return false}
async function checkUpdate(){progress.style.display='block';bar.style.width='8%';ptext.textContent='Vérification…';updateStatus.textContent='';try{const r=await fetch(MANIFEST+'?t='+Date.now(),{cache:'no-store'});bar.style.width='25%';if(!r.ok)throw 0;const j=await r.json();if(!newer(j.version,LOCAL_VERSION)){bar.style.width='100%';ptext.textContent='100 %';updateStatus.textContent='Application à jour ✓';return}const url=j.apk;if(!url)throw 0;ptext.textContent='Nouvelle version '+j.version+' — téléchargement';const d=await fetch(url,{cache:'no-store'});if(!d.ok)throw 0;const total=Number(d.headers.get('content-length'))||0;const reader=d.body.getReader();let chunks=[],got=0;while(true){const q=await reader.read();if(q.done)break;chunks.push(q.value);got+=q.value.length;const pct=total?Math.min(98,25+Math.round(got/total*73)):Math.min(98,25+Math.round(got/100000));bar.style.width=pct+'%';ptext.textContent=pct+' %'}const blob=new Blob(chunks,{type:'application/vnd.android.package-archive'});bar.style.width='100%';ptext.textContent='100 %';updateStatus.textContent='Téléchargement terminé. Ouverture de l’installation…';const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='Carlplay-update.apk';a.click()}catch(e){updateStatus.textContent='Internet nécessaire ou mise à jour indisponible.';progress.style.display='none'}}
</script></body></html>